{
  "backbone": "resnet34",
  "channels": 128,
  "no_pretrained": false,
  "freeze_until": "layer1",
  "no_frozen_bn": false,
  "prior_prob": 0.01,
  "data_root": "data\\fieldnet_v23",
  "image_size": 416,
  "batch_size": 4,
  "num_workers": 4,
  "no_augment": false,
  "scale_min": 0.7,
  "scale_max": 1.3,
  "train_ann_name": "annotations.json",
  "epochs": 60,
  "lr": -1.0,
  "backbone_lr_mult": -1.0,
  "weight_decay": 0.0001,
  "warmup_iters": 500,
  "min_lr_ratio": 0.01,
  "clip_grad": 10.0,
  "accum_steps": 4,
  "no_amp": false,
  "lambda_field": 1.0,
  "lambda_box": 2.0,
  "lambda_unc": 0.0,
  "qfl_beta": 2.0,
  "box_mode": "ciou",
  "no_class_weight": false,
  "class_weight_alpha": 0.5,
  "normalizer": "pos_count",
  "neg_weight": 1.0,
  "no_class_mask": false,
  "box_normalizer": "object",
  "no_ema": false,
  "ema_decay": 0.9998,
  "eval_every": 2,
  "eval_split": "valid",
  "eval_weights": "both",
  "select_on": "ema",
  "score_thresh_decode": 0.02,
  "score_thresh": 0.3,
  "nms_iou": 0.6,
  "max_detections": 100,
  "out_dir": "outputs\\v3_ft_mask",
  "tag": "ft_mask",
  "seed": 0,
  "resume": "",
  "log_every": 20,
  "overfit": 0,
  "skip_prior_check": false,
  "resolved_lr": 0.00025,
  "resolved_backbone_mult": 0.1,
  "num_classes": 14,
  "class_names": [
    "person",
